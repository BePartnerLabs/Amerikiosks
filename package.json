{
  "name": "amerikiosks",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "drop:prod": "cross-env NODE_ENV=production node scripts/drop-prod.mjs",
    "migrate:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:prod:local": "dotenv -e .env.production.local -- cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload migrate",
    "build": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap && cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:coverage": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@img/sharp-linux-x64": "^0.35.3",
    "@payloadcms/admin-bar": "3.85.2",
    "@payloadcms/db-postgres": "3.85.2",
    "@payloadcms/live-preview-react": "3.85.2",
    "@payloadcms/next": "3.85.2",
    "@payloadcms/plugin-form-builder": "3.85.2",
    "@payloadcms/plugin-import-export": "3.85.2",
    "@payloadcms/plugin-mcp": "^3.85.2",
    "@payloadcms/plugin-nested-docs": "3.85.2",
    "@payloadcms/plugin-redirects": "3.85.2",
    "@payloadcms/plugin-search": "3.85.2",
    "@payloadcms/plugin-seo": "3.85.2",
    "@payloadcms/richtext-lexical": "3.85.2",
    "@payloadcms/storage-s3": "^3.85.2",
    "@payloadcms/ui": "3.85.2",
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "17.4.2",
    "geist": "^1.7.2",
    "graphql": "^16.14.2",
    "lucide-react": "1.23.0",
    "next": "16.2.10",
    "next-intl": "^4.13.1",
    "next-sitemap": "^4.2.3",
    "payload": "3.85.2",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.81.0",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/escape-html": "^1.0.2",
    "@types/node": "26.1.0",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.2",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "^17.0.8",
    "pg": "^8.22.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "tsx": "4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vercel": "^54.21.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "biome check --write --no-errors-on-unmatched",
    "*.css": "node scripts/validate-ds-tokens.mjs"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "supportedArchitectures": {
      "os": [
        "darwin",
        "linux"
      ],
      "cpu": [
        "arm64",
        "x64"
      ]
    }
  }
}
