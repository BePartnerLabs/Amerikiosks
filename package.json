{
  "name": "amerikiosks",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "migrate:prod": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:prod:local": "dotenv -e .env.production.local -- cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload migrate",
    "build": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap && cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:coverage": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1104.0",
    "@aws-sdk/s3-request-presigner": "3.1104.0",
    "@img/sharp-linux-x64": "^0.35.3",
    "@payloadcms/admin-bar": "3.87.0",
    "@payloadcms/db-postgres": "3.87.0",
    "@payloadcms/live-preview-react": "3.87.0",
    "@payloadcms/next": "3.87.0",
    "@payloadcms/plugin-form-builder": "3.87.0",
    "@payloadcms/plugin-mcp": "^3.87.0",
    "@payloadcms/plugin-nested-docs": "3.87.0",
    "@payloadcms/plugin-redirects": "3.87.0",
    "@payloadcms/plugin-search": "3.87.0",
    "@payloadcms/plugin-seo": "3.87.0",
    "@payloadcms/richtext-lexical": "3.87.0",
    "@payloadcms/storage-s3": "^3.87.0",
    "@payloadcms/translations": "3.87.0",
    "@payloadcms/ui": "3.87.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "17.4.2",
    "geist": "^1.7.2",
    "graphql": "^16.14.2",
    "lucide-react": "1.28.0",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "next-sitemap": "^4.2.3",
    "payload": "3.87.0",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@material-symbols/svg-400": "^0.45.10",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/escape-html": "^1.0.2",
    "@types/node": "26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "^17.3.0",
    "pg": "^8.22.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vercel": "^58.7.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "biome check --write --no-errors-on-unmatched",
    "*.css": "node scripts/validate-ds-tokens.mjs",
    "*.{ts,tsx,jsx}": "node scripts/validate-no-raw-icon-image.mjs",
    "src/blocks/*/{Component,Server}.tsx": "node scripts/validate-block-markup.mjs"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "^10 || ^11"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
