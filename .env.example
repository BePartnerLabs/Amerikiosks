# ─── Database ────────────────────────────────────────────────────────────────
# Production/preview: Neon Postgres (get from Vercel env vars or Neon console)
# Local with Docker:  postgresql://payload:payload@localhost:5432/amerikiosks
DATABASE_URL=

# ─── Payload ─────────────────────────────────────────────────────────────────
# Encryption secret — generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Public URL — no trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Storage ─────────────────────────────────────────────────────────────────
# Production (Cloudflare R2): fill all five vars.
#   S3_ENDPOINT  → https://<account-id>.r2.cloudflarestorage.com
#   S3_PUBLIC_URL → public CDN URL for the bucket (used by next/image)
#
# Local dev points at the same R2 bucket — ask for a scoped token rather than
# running a local S3. There is no local object store in this project anymore.
#
# Leave all empty to fall back to disk storage in /public/media.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_REGION=

# Separate, non-public R2 bucket for files that only need to exist long enough
# for an outbound integration (JotForm, Monday, ...) to fetch them once — e.g.
# the Claims refund flow's photo attachment. Same credentials as S3_* above
# (same R2 account), different bucket name, with no public access/custom
# domain ever configured on it in Cloudflare. See src/utilities/privateUpload.ts.
S3_PRIVATE_NAME=

# ─── Optional ────────────────────────────────────────────────────────────────
# Secret used to authenticate cron jobs
CRON_SECRET=

# Odoo CRM endpoint for brand program form submissions
ODOO_ENDPOINT=

# JotForm API key — used by JotFormRepository to submit customer-service claims
# (interim integration target while Odoo's REST API isn't ready, see Claims collection)
JOTFORM_API_KEY=

# ─── Monday.com ──────────────────────────────────────────────────────────────
# The API token itself lives in /admin (Settings → Integrations), not here.
#
# In development every Monday call is mocked and logged to the console instead
# of being sent. There is a sandbox account with [LAB] copies of the boards —
# run `node scripts/move-monday-to-sandbox.mjs --apply` after a production
# restore, put your own token in MONDAY_API_TOKEN, then set this to true to
# exercise the integration for real. Items land in the sandbox; delete them
# when you are done.
# MONDAY_LIVE=true

# ─── Content gating ──────────────────────────────────────────────────────────
# Comma-separated path prefixes that require a Payload session (i.e. being
# logged into /admin). Anyone else is redirected to the site root. Use it while
# copy is still being reviewed — e.g. the Spanish site before the client signs
# off on the translations, or a section that is not ready.
#
#   GATED_PATHS=/es,/machines
#
# Matches on segment boundaries, so /es covers /es/faq but not /estadisticas.
# Unset means nothing is gated. This HIDES, it does not protect: the check is
# whether a payload-token cookie is present, which is easy to fake. Fine for
# unapproved copy, not for anything confidential.

# ─── Media ───────────────────────────────────────────────────────────────────
# Which file types an editor may upload to the media collection, comma
# separated. Unset uses the defaults in src/utilities/mediaMimeTypes.ts, which
# include SVG — several partner logos are vectors. Set this to override, e.g.
# to drop SVG in a hurry without shipping code. Mime types, not extensions:
# Payload validates the file's real type. Read when the config is built, so a
# change needs a redeploy.
# SUPPORTED_MEDIA_TYPES=image/jpeg,image/png,image/webp,video/mp4
