# ─── Database ────────────────────────────────────────────────────────────────
# Production/preview: Neon Postgres (get from Vercel env vars or Neon console)
# Local with Docker:  postgresql://payload:payload@localhost:5432/amerikiosks
DATABASE_URL=

# ─── Payload ─────────────────────────────────────────────────────────────────
# Encryption secret — generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Public URL — no trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Storage ─────────────────────────────────────────────────────────────────
# Production (Cloudflare R2): fill all five vars.
#   S3_ENDPOINT  → https://<account-id>.r2.cloudflarestorage.com
#   S3_PUBLIC_URL → public CDN URL for the bucket (used by next/image)
#
# Local dev (MinIO via docker-compose): use the values below.
#   Console at http://localhost:9001  user/pass: minioadmin / minioadmin
#
# Leave all empty to fall back to disk storage in /public/media.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── MinIO local defaults (copy these into your .env for local S3 dev) ─────────
# S3_BUCKET=amerikiosks
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PUBLIC_URL=http://localhost:9000

# ─── Optional ────────────────────────────────────────────────────────────────
# Secret used to authenticate cron jobs
CRON_SECRET=

# Used to validate preview requests
PREVIEW_SECRET=

# Odoo CRM endpoint for brand program form submissions
ODOO_ENDPOINT=
