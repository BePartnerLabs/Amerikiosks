# ─── Database ────────────────────────────────────────────────────────────────
# Production/preview: Neon Postgres (get from Vercel env vars or Neon console)
# Local with Docker:  postgresql://payload:payload@localhost:5432/amerikiosks
DATABASE_URL=

# ─── Payload ─────────────────────────────────────────────────────────────────
# Encryption secret — generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Public URL — no trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Storage (Cloudflare R2) ──────────────────────────────────────────────────
# Leave all empty for local dev — assets will be saved to /public/media instead.
# Get from: Cloudflare dashboard → R2 → your bucket → Manage API tokens
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────
# Secret used to authenticate cron jobs
CRON_SECRET=

# Used to validate preview requests
PREVIEW_SECRET=

# Odoo CRM endpoint for brand program form submissions
ODOO_ENDPOINT=
