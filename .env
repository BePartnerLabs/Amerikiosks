# Database connection string (Neon or local Postgres)
DATABASE_URL=

# Payload encryption secret — generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Public URL — no trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=

# Used to validate preview requests
PREVIEW_SECRET=

# Password to access the preview-protected site
PREVIEW_PASSWORD=
