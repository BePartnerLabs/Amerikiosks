{
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "sourceMap": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@payload-config": [
        "./src/payload.config.ts"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "@/*": [
        "./src/*"
      ],
      "@/blocks/*": ["./src/blocks/*"],
      "@/collections/*": ["./src/collections/*"],
      "@/components/*": ["./src/components/*"],
      "@/fields/*": ["./src/fields/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/utilities/*": ["./src/utilities/*"],
      "@/providers/*": ["./src/providers/*"],
      "@/heros/*": ["./src/heros/*"],
      "@/access/*": ["./src/access/*"],
      "@/endpoints/*": ["./src/endpoints/*"],
      "@/plugins/*": ["./src/plugins/*"],
      "@/search/*": ["./src/search/*"],
      "@/i18n/*": ["./src/i18n/*"],
      "@/messages/*": ["./src/messages/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "redirects.js",
    "next-env.d.ts",
    "next.config.js",
    "next-sitemap.config.cjs",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
